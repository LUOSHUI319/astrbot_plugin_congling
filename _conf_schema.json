{
  "basic": {
    "description": "基础设置",
    "hint": "启用范围与管理员。改动后需重载插件才完全生效。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用插件",
        "type": "bool",
        "default": true
      },
      "enable_private": {
        "description": "私聊生效",
        "type": "bool",
        "default": true
      },
      "enable_group": {
        "description": "群聊生效",
        "type": "bool",
        "default": true
      },
      "platforms": {
        "description": "生效平台",
        "hint": "默认只对 aiocqhttp（OneBot v11）生效",
        "type": "list",
        "default": [
          "aiocqhttp"
        ]
      },
      "extra_admins": {
        "description": "额外管理员",
        "hint": "一行一个 QQ 号。AstrBot 全局管理员自动算在内，这里只补额外的人",
        "type": "list",
        "default": []
      },
      "include_group_role": {
        "description": "群主/群管也算管理员",
        "hint": "默认不算。开了之后群里任何管理员都能发说说、看到管理信息",
        "type": "bool",
        "default": false
      }
    }
  },
  "persona": {
    "description": "人格档案",
    "hint": "「绫」的人格内核。UI 里改更直观，这里只是默认值。",
    "type": "object",
    "items": {
      "mode": {
        "description": "人设来源",
        "hint": "builtin=使用本插件内置的「绫」；astrbot=使用 AstrBot 里已有的人格；none=完全交给 AstrBot 默认人设，本插件不注入任何人设文本",
        "type": "string",
        "options": [
          "builtin",
          "astrbot",
          "none"
        ],
        "default": "builtin"
      },
      "astrbot_persona_id": {
        "description": "选择 AstrBot 人格",
        "hint": "仅当人设来源为 astrbot 时生效。留空表示使用 AstrBot 的默认人格",
        "type": "string",
        "default": ""
      },
      "persona_id": {
        "description": "人格 ID",
        "hint": "所有模块用这个字段区分不同人格，默认 ling",
        "type": "string",
        "default": "ling"
      },
      "name": {
        "description": "名字",
        "type": "string",
        "default": "绫"
      },
      "identity": {
        "description": "身份设定",
        "hint": "用自然语言写清她是谁、怎么说话、在意什么。留空则使用内置默认人设。",
        "type": "text",
        "default": ""
      },
      "active_hours": {
        "description": "活跃时段",
        "hint": "格式 start-end，如 09:00-03:30。用于静默判断，不做强制拦截。",
        "type": "string",
        "default": "09:00-03:30"
      },
      "version_history_limit": {
        "description": "人格历史版本保留数",
        "type": "int",
        "default": 20
      }
    }
  },
  "humanize": {
    "description": "拟人化表达",
    "hint": "决定它回不回、分几句、隔多久。这些参数直接决定「像不像人」。",
    "type": "object",
    "items": {
      "enable_persona_inject": {
        "description": "注入人格提示词",
        "hint": "若同时运行 private_companion，建议关闭本项由对方负责人格，本插件只做表达层",
        "type": "bool",
        "default": true
      },
      "reply_threshold": {
        "description": "回复阈值",
        "hint": "判断得分 ≥ 该值才回复；低于阈值按概率抽签。默认 35",
        "type": "int",
        "default": 35
      },
      "reply_window_seconds": {
        "description": "连续对话窗口（秒）",
        "hint": "刚回过一次后，窗口内阈值降低，形成「聊起来」的连贯感",
        "type": "int",
        "default": 300
      },
      "max_bubbles_private": {
        "description": "私聊最多分几条",
        "type": "int",
        "default": 3
      },
      "max_bubbles_group": {
        "description": "群聊最多分几条",
        "type": "int",
        "default": 2
      },
      "think_delay_base": {
        "description": "首条思考延迟基准（秒）",
        "hint": "实际延迟 = 基准 + 0.02 * 输入字数，随机扰动 ±30%",
        "type": "float",
        "default": 1.2
      },
      "reply_delay": {
        "description": "延时回复（额外犹豫）",
        "hint": "在原本的思考延时之上再随机等一会儿，像人在打字。关掉不影响正常节奏",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用延时回复",
            "hint": "默认关闭。开启后首条回复会多等 min~max 秒（与节奏控制合并，不会重复发送）",
            "type": "bool",
            "default": false
          },
          "min_seconds": {
            "description": "最短额外等待（秒）",
            "type": "float",
            "default": 2.0
          },
          "max_seconds": {
            "description": "最长额外等待（秒）",
            "hint": "与思考延时相加后上限 25 秒，超了会自动收",
            "type": "float",
            "default": 8.0
          },
          "probability": {
            "description": "触发概率",
            "hint": "0~1，1 表示每次回复都犹豫",
            "type": "float",
            "default": 1.0
          },
          "apply_private": {
            "description": "私聊生效",
            "type": "bool",
            "default": true
          },
          "apply_group": {
            "description": "群聊生效",
            "hint": "群里慢吞吞容易被当成掉线，默认关",
            "type": "bool",
            "default": false
          },
          "night_scale": {
            "description": "深夜倍率",
            "hint": "凌晨 1~5 点把等待时间乘以这个系数，困了慢但别慢到像掉线",
            "type": "float",
            "default": 0.7
          }
        }
      },
      "bubble_delay_factor": {
        "description": "逐条延迟系数（秒/字）",
        "hint": "实际延迟 = 0.6 + 系数 * 本条字数",
        "type": "float",
        "default": 0.09
      },
      "quote_probability": {
        "description": "引用概率基准",
        "hint": "被回复/话题切换/长消息会动态上调，上限由下一项决定",
        "type": "float",
        "default": 0.08
      },
      "quote_probability_max": {
        "description": "引用概率上限",
        "hint": "动态加成后能到的最高值。设 1 就是该引就引，不再压到 0.35",
        "type": "float",
        "default": 0.35
      },
      "quote_cooldown_seconds": {
        "description": "同一会话引用冷却（秒）",
        "hint": "刚引用过就别再引用，0 表示不冷却",
        "type": "int",
        "default": 30
      },
      "quote_max_age_seconds": {
        "description": "引用时效（秒）",
        "hint": "只引用这个时间以内的消息；主动消息、延时回复不会去引几小时前那句。0 表示不限",
        "type": "int",
        "default": 180
      },
      "typo_probability": {
        "description": "打错再改概率",
        "hint": "0.03~0.08 比较自然，别调高，高了就假",
        "type": "float",
        "default": 0.04
      },
      "sticker_enabled": {
        "description": "发送表情包",
        "hint": "需安装「表情包小偷」插件，按其情绪标签检索，未命中则不发",
        "type": "bool",
        "default": true
      },
      "voice_enabled": {
        "description": "允许语音条",
        "type": "bool",
        "default": true
      },
      "voice_id": {
        "description": "语音音色",
        "type": "string",
        "default": "zhangzixin"
      }
    }
  },
  "guard": {
    "description": "输出守卫",
    "hint": "发送前的硬性清理规则。与 no_newline / quote_probability 同时存在时，本插件会自动关闭同名规则避免互相覆盖。",
    "type": "object",
    "items": {
      "strip_emoji": {
        "description": "移除 emoji",
        "type": "bool",
        "default": true
      },
      "strip_trailing_period": {
        "description": "去掉句末句号",
        "hint": "只去「。」，保留问号、感叹号、省略号",
        "type": "bool",
        "default": true
      },
      "flatten_newline": {
        "description": "压平换行",
        "type": "bool",
        "default": true
      },
      "max_chars_per_bubble": {
        "description": "单条最大字数",
        "type": "int",
        "default": 60
      },
      "forbid_phrases": {
        "description": "禁用短语",
        "type": "list",
        "default": [
          "作为AI",
          "作为一个AI",
          "希望对你有帮助",
          "总结一下",
          "有什么可以帮你"
        ]
      },
      "self_repeat_guard": {
        "description": "重复自检",
        "hint": "与最近 5 条相似度过高时重写或丢弃",
        "type": "bool",
        "default": true
      }
    }
  },
  "perception": {
    "description": "特殊消息感知",
    "hint": "合并转发、引用、卡片、图片、语音的解析。这是它「真的看懂了」的基础。",
    "type": "object",
    "items": {
      "expand_forward": {
        "description": "展开合并转发",
        "type": "bool",
        "default": true
      },
      "forward_max_nodes": {
        "description": "转发最多展开条数",
        "type": "int",
        "default": 60
      },
      "forward_max_depth": {
        "description": "转发最大递归层数",
        "type": "int",
        "default": 2
      },
      "forward_summary_threshold": {
        "description": "转发摘要阈值（字）",
        "hint": "超过此长度先摘要再注入，原文仍入库可查",
        "type": "int",
        "default": 1200
      },
      "quote_depth": {
        "description": "引用链展开层数",
        "type": "int",
        "default": 3
      },
      "image_describe": {
        "description": "图片理解",
        "hint": "需配置视觉模型（如 MiniMax）；未配置时只标注「一张图片」",
        "type": "bool",
        "default": true
      },
      "voice_transcribe": {
        "description": "语音转文字",
        "type": "bool",
        "default": true
      },
      "card_parse": {
        "description": "解析卡片与小程序",
        "type": "bool",
        "default": true
      },
      "recent_context_count": {
        "description": "补几条最近的会话上下文",
        "hint": "群聊里没被叫到的时候消息不进对话历史，这里把最近几条（含已展开的转发）补进 prompt。0 关闭",
        "type": "int",
        "default": 6
      },
      "recent_context_chars": {
        "description": "上下文注入字数上限",
        "hint": "超了就只保留最近的几条，防止把上下文吃满",
        "type": "int",
        "default": 1500
      }
    }
  },
  "memory": {
    "description": "长期记忆",
    "hint": "档位 auto 会自动探测：有 embedding 用全功能，没有就降级，不报错。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用记忆",
        "type": "bool",
        "default": true
      },
      "tier": {
        "description": "检索档位",
        "type": "string",
        "options": [
          "auto",
          "A",
          "B",
          "C",
          "D"
        ],
        "default": "auto"
      },
      "embedding_provider_id": {
        "description": "Embedding 模型 ID",
        "hint": "留空则不走向量检索",
        "type": "string",
        "_special": "select_provider",
        "default": ""
      },
      "llm_provider_id": {
        "description": "记忆抽取模型 ID",
        "hint": "用于抽取原子记忆与生成摘要，留空用默认模型",
        "type": "string",
        "_special": "select_provider",
        "default": ""
      },
      "idle_extract_seconds": {
        "description": "静默多久后抽取（秒）",
        "type": "int",
        "default": 90
      },
      "batch_extract_size": {
        "description": "累计多少条触发抽取",
        "type": "int",
        "default": 30
      },
      "inject_top_k": {
        "description": "注入记忆条数",
        "type": "int",
        "default": 5
      },
      "inject_budget_ratio": {
        "description": "记忆占上下文预算比例",
        "type": "float",
        "default": 0.25
      },
      "decay_factor": {
        "description": "每日衰减系数",
        "type": "float",
        "default": 0.985
      },
      "archive_after_days": {
        "description": "多少天未命中转归档",
        "type": "int",
        "default": 30
      },
      "forget_after_days": {
        "description": "多少天未命中转遗忘",
        "type": "int",
        "default": 90
      },
      "reflect_hour": {
        "description": "每日反思时间（小时）",
        "type": "int",
        "default": 4
      },
      "levels": {
        "description": "记忆等级",
        "hint": "记忆分 1~5 级，另有 0 级不可忘。等级决定忘得多快、注入时排多前",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用记忆等级",
            "type": "bool",
            "default": true,
            "hint": "关掉退回全局单因子衰减，等级字段保留但不参与计算"
          },
          "manual_edit": {
            "description": "允许手动改等级",
            "type": "bool",
            "default": true,
            "hint": "打开后可以在记忆库里直接改某条的等级，改完不会被模型覆盖"
          }
        }
      },
      "forgetting": {
        "description": "遗忘曲线",
        "hint": "off 不衰减；dream 照着长夜的梦境衰减来（忘得快）；balanced 取 dream 与 ebbinghaus 的中间；ebbinghaus 走经典遗忘曲线（最保守）",
        "type": "object",
        "items": {
          "mode": {
            "description": "衰减档位",
            "type": "string",
            "options": [
              "off",
              "dream",
              "balanced",
              "ebbinghaus"
            ],
            "default": "balanced",
            "hint": "默认 balanced：随口的话一周左右散掉，认真说过的事能留几个月"
          },
          "archive_ratio": {
            "description": "归档阈值",
            "type": "float",
            "default": 0.45,
            "hint": "强度低于这个比例就进归档，不再主动注入但还能翻到"
          },
          "forget_ratio": {
            "description": "遗忘阈值",
            "type": "float",
            "default": 0.12,
            "hint": "再低就标记遗忘，仍可手动找回"
          },
          "hit_boost": {
            "description": "命中后强度加成",
            "type": "float",
            "default": 1.5,
            "hint": "被用到一次，强度上限和周期都会按这个系数延长，越用越牢"
          }
        }
      },
      "affinity": {
        "description": "好感度",
        "hint": "按记忆等级、对话频率、冷淡天数综合结算，每天结算一次",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用好感度",
            "type": "bool",
            "default": true
          },
          "ui_editable": {
            "description": "允许在面板上手动调",
            "type": "bool",
            "default": true,
            "hint": "关掉后只能看不能改，自动结算照常"
          },
          "manual_override": {
            "description": "手改后冻结自动结算",
            "type": "bool",
            "default": false,
            "hint": "开启后手动改过的用户不再被自动加减，适合固定关系"
          },
          "stage_names": {
            "description": "阶段名称（6 项）",
            "type": "list",
            "default": [
              "陌生",
              "眼熟",
              "熟人",
              "朋友",
              "亲近",
              "交心"
            ]
          },
          "stage_thresholds": {
            "description": "阶段门槛分数（6 项）",
            "type": "list",
            "default": [
              0,
              100,
              250,
              450,
              650,
              850
            ]
          },
          "max_daily_delta": {
            "description": "单日最大变化",
            "type": "float",
            "default": 15.0,
            "hint": "防止一天刷满，正负都受限"
          },
          "neglect_days": {
            "description": "多少天不说话开始掉",
            "type": "int",
            "default": 3,
            "hint": "掉分不会跨档，每档都有下限"
          }
        }
      },
      "user_profile": {
        "description": "用户画像",
        "hint": "把某个人的记忆压缩成一段认识，注入到提示词里",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用用户画像",
            "type": "bool",
            "default": true
          },
          "whitelist_enabled": {
            "description": "只给白名单里的人画像",
            "type": "bool",
            "default": false,
            "hint": "关着的时候所有用户都可能被画像（仍受好感度门槛限制）"
          },
          "whitelist": {
            "description": "白名单用户 ID",
            "type": "list",
            "default": [],
            "hint": "一行一个 QQ 号，只有开了上面的开关才生效"
          },
          "blocklist": {
            "description": "不再画像名单",
            "type": "list",
            "default": [],
            "hint": "删画像时自动加进来，移除后才会重新生成"
          },
          "min_stage": {
            "description": "最低好感阶段",
            "type": "int",
            "default": 2,
            "hint": "好感没到这一档，不会为对方生成画像。0 陌生 / 2 熟人 / 5 交心"
          },
          "max_keywords": {
            "description": "关键词上限",
            "type": "int",
            "default": 32
          }
        }
      }
    }
  },
  "capability": {
    "description": "实用查询能力",
    "hint": "每个能力都能在 UI「工具」页单独开关与试跑。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用工具集",
        "type": "bool",
        "default": true
      },
      "groups": {
        "description": "启用的能力分组",
        "type": "list",
        "default": [
          "life",
          "entertain",
          "knowledge",
          "game",
          "self",
          "qzone"
        ],
        "hint": "可选 life / entertain / knowledge / game / self / qzone；qzone 里的发说说需要管理员"
      },
      "default_timeout": {
        "description": "默认超时（秒）",
        "type": "float",
        "default": 8.0
      },
      "rate_limit_per_min": {
        "description": "每会话每分钟调用上限",
        "type": "int",
        "default": 20
      },
      "web_search_enabled": {
        "description": "允许联网搜索",
        "hint": "默认关闭，开启后注意成本",
        "type": "bool",
        "default": false
      }
    }
  },
  "qq_extra": {
    "description": "QQ 扩展",
    "hint": "写操作（发说说/改签名）默认关闭，避免风控。",
    "type": "object",
    "items": {
      "qzone_mode": {
        "description": "空间模式",
        "type": "string",
        "options": [
          "auto",
          "builtin",
          "off"
        ],
        "default": "auto",
        "hint": "auto/builtin 都是本插件自己打空间接口（登录态从 OneBot 取）；off 完全不碰"
      },
      "qzone_allow_write": {
        "description": "允许写入空间",
        "hint": "发说说需要。0.5.0 起默认开启，配合每日配额与内容过滤，不会乱发",
        "type": "bool",
        "default": true
      },
      "qzone_cookie": {
        "description": "手动填空间 Cookie",
        "hint": "留空即可，会自动从 OneBot 取。只有在协议端拿不到 cookie 时才需要手填（uin、skey、p_skey）",
        "type": "text",
        "default": ""
      },
      "qzone_page_size": {
        "description": "每次读几条动态",
        "type": "int",
        "default": 5
      },
      "qzone_read_others": {
        "description": "允许看别人的空间",
        "hint": "关掉后只能看说话人自己的空间。注意空间主页动态读的是公开可见部分",
        "type": "bool",
        "default": true
      },
      "qzone_auto_post": {
        "description": "每日自动发说说",
        "type": "bool",
        "default": true,
